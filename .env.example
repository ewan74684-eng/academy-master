# Database Configuration
# Main Local XAMPP MySQL Instance
DATABASE_URL=mysql://root:@localhost:3306/test3 

# Or use individual database connection variables
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=your_username
# DB_PASSWORD=your_password
# DB_NAME=academy_crm

# # Application Configuration
# NODE_ENV=development
# PORT=5000

ADMIN_USERNAME = admin
ADMIN_PASSWORD = 1232453676

# Extra password asked for (on top of the login) before showing the Employees and
# Expenses pages and Special Needs players. Those stay locked until it is set.
PROTECTED_AREA_PASSWORD =
# Minutes a correct password keeps them unlocked (default 15). Logging out locks them.
# PROTECTED_AREA_TIMEOUT_MINUTES = 15

# Cloudinary Configuration (Required for file uploads)
# Get these from: https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret